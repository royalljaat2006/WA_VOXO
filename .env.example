# Copy to .env and fill in what you have. Missing keys are skipped, so the
# project runs with just the local model on day one.
#
#   cp .env.example .env

# ─── Phase 0: Speech-to-text ────────────────────────────────────────────────

# Local Whisper — free, no key, runs on your Mac. Keep this on as a baseline:
# a paid engine that cannot beat it is not worth its bill.
RUN_LOCAL_WHISPER=1
WHISPER_MODEL=large-v3
# Blank = auto-detect. "hi" forces Devanagari output, "en" forces Latin —
# this changes Hinglish results a lot, so benchmark both.
WHISPER_LANG=

OPENAI_API_KEY=
OPENAI_MODELS=whisper-1,gpt-4o-transcribe

# Sarvam AI — Indic-first, usually the strongest candidate for Hinglish.
SARVAM_API_KEY=
SARVAM_MODEL=saarika:v2.5
# "unknown" lets saarika:v2.5 detect the language and tell us which it was — the
# detected tag is what makes the bot answer a Tamil speaker in Tamil. Pin a tag
# ("hi-IN") only for a deployment you know is monolingual: it is marginally more
# accurate there, and silently mistranscribes everything else.
SARVAM_LANG=unknown

ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=scribe_v1

STT_TIMEOUT_S=180

# Which engine build_primary_transcriber uses for real traffic (Phase 3+).
# Decided from a real benchmark on data/audio, not guessed — Sarvam ran ~15x
# faster than local Whisper (0.7s vs ~11s avg) and was more accurate on
# Hindi/Hinglish. See docs/phase-0-stt-benchmark.md § Results.
# Blank = fall back to the first configured engine (local Whisper on a fresh
# checkout with no keys set).
STT_ENGINE=sarvam

# Optional second engine, tried only if STT_ENGINE raises (network/key
# failure) — a resilience choice, independent of the benchmark above. Every
# voice note pays STT_ENGINE's own latency first; picking a slower primary
# here means a slower reply on every message, not just during an outage.
# STT_ENGINE_FALLBACK=sarvam

# ─── Phase 1: WhatsApp Cloud API ────────────────────────────────────────────
# From the Meta app dashboard — see docs/phase-1-meta-setup.md.

# Temporary token (~24h) from WhatsApp → API Setup, or a permanent System User
# token for anything beyond a quick test.
WHATSAPP_ACCESS_TOKEN=
# The test/business number's ID (NOT the phone number itself) — same API Setup page.
WHATSAPP_PHONE_NUMBER_ID=

# ─── Phase 2: webhook (not needed for Phase 1) ──────────────────────────────
# A random string YOU invent; you paste the same value into Meta's webhook config
# so the server can prove a verification GET is really from Meta.
WHATSAPP_VERIFY_TOKEN=
# App secret (Meta app → Settings → Basic) — verifies X-Hub-Signature-256 on
# incoming webhooks. Needed in Phase 2, not Phase 1.
WHATSAPP_APP_SECRET=

# Optional overrides
# WHATSAPP_API_VERSION=v21.0
# WHATSAPP_TIMEOUT_S=30

# ─── Which behaviour the server runs ────────────────────────────────────────
# echo       — Phase 2: reply with what we understood (no transcription)
# transcribe — Phase 3: voice note in, transcript out
# agent      — Phase 4: voice note in, answered from campaign data
# payment    — voice-initiated transfer with a spoken PIN (needs PAYMENTS_ENABLED)
HANDLER=echo

# ─── Phase 4: the agent ─────────────────────────────────────────────────────
# Which LLM answers: claude | nemotron. See docs/phase-4-agent.md for the
# comparison and for why the two need separate settings.
AGENT_PROVIDER=claude

# --- provider: claude (Anthropic) ---
ANTHROPIC_API_KEY=
# AGENT_MODEL=claude-sonnet-5
# AGENT_EFFORT=medium            # low | medium | high | xhigh | max — Claude only

# --- provider: nemotron (NVIDIA NIM) ---
NVIDIA_API_KEY=
# NEMOTRON_MODEL=nvidia/nemotron-3-ultra-550b-a55b
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# AGENT_TEMPERATURE=0.2          # NVIDIA only — Claude rejects this
# AGENT_MAX_TOKENS=1024
# AGENT_MAX_TOOL_TURNS=6         # ceiling on model turns per user message
# AGENT_MAX_HISTORY_TURNS=20     # how much history each request carries
# AGENT_IDLE_TIMEOUT_S=3600      # after this, a follow-up starts a fresh thread
# AGENT_TIMEOUT_S=60

# Where campaign data comes from. Only "stub" exists — it returns FAKE numbers so
# the pipeline can be demonstrated before eko API access lands. Adding a real
# source means implementing CampaignDataSource in agent/datasource.py.
# AGENT_DATA_SOURCE=stub          # 'eko' once EKO_REPORT_* codes are filled in

# ─── Phase 5: who may use it ────────────────────────────────────────────────
# REQUIRED. An empty allowlist denies everyone — that is the safe default, not a
# bug. Format: number:role,number:role  (a bare number gets AUTH_DEFAULT_ROLE)
# Roles: viewer | analyst | admin  — all READ-ONLY.
#
# Sending money is a separate capability, not a higher role. Suffix "+pay" to
# grant it: 919876543210:admin+pay,919000000001:viewer
# A plain "admin" can see everything and still cannot send a rupee. The suffix is
# deliberately ugly — nobody adds it by accident.
WHATSAPP_ALLOWED_NUMBERS=

# Alternative to the line above, for a team that grows or turns over often: a
# file in the same "number:role" syntax, one entry per line, comments after
# '#' allowed. Re-read only when the file's mtime changes, so adding or
# removing a number takes effect on the next message — no redeploy. When set,
# this is authoritative and WHATSAPP_ALLOWED_NUMBERS above is ignored.
# WHATSAPP_ALLOWED_NUMBERS_FILE=data/allowed_numbers.txt

# Numbers that may maintain the allowlist over WhatsApp (needs the FILE above):
#   /adduser 919812345678 viewer     /removeuser 919812345678     /listusers
#
# Grants no access on its own — a super-user must ALSO be on the allowlist, and
# still counts against the rate limit. Deliberately env-only: if this list lived
# in the file those commands can edit, a super-user could mint more super-users
# from a phone, and one borrowed handset would be permanent.
#
# +pay is NOT grantable this way, by design — see docs/phase-5-auth.md.
# WHATSAPP_SUPERUSER_NUMBERS=919812345678

# AUTH_DEFAULT_ROLE=viewer
# AUTH_RATE_LIMIT=20             # messages per caller per window
# AUTH_RATE_LIMIT_WINDOW_S=3600

# Set to false ONLY for local testing against your own number. Never with real
# data — it answers every number that reaches the server.
# AUTH_ENABLED=true

# ─── Groups ─────────────────────────────────────────────────────────────────
# Needs an Official Business Account. Meta's rules shape the product here: the
# business must CREATE the group (it cannot be added to one), max 8
# participants, one Cloud API business per group, and buttons are never
# delivered — so group confirmations are plain text.
GROUPS_ENABLED=false

# What summons the bot. Meta sends no structured "mentions" field for Cloud API
# groups, so these are matched as substrings of the message text.
# GROUP_WAKE_WORDS=@eko,eko bot,@bot,एको

# How long a group stays awake after being summoned. Long enough for a
# follow-up, short enough that the bot is not quietly listening to a meeting.
# While dormant, group voice notes are not even downloaded.
# GROUP_AWAKE_FOR_S=300

# LEAVE THIS ALONE. A PIN spoken as a voice note in a group is audible to every
# participant and stays there to be replayed. Restricting *who* may pay does not
# help — it is the payer's own PIN being exposed. Payment requests in a group are
# answered with "message me directly" instead.
# GROUP_ALLOW_PAYMENTS=false

# ─── Voice payments ─────────────────────────────────────────────────────────
# Off by default. Money should require someone to have opted in, not merely to
# have failed to opt out. Set HANDLER=payment as well — the handler refuses to
# start if payments are not also enabled.
PAYMENTS_ENABLED=false

# Only 'stub' exists until eko payment API access lands. The stub moves NO real
# money and every receipt is labelled TEST MODE. See agent/payments.py.
# PAYMENT_GATEWAY=stub

# Caps, in paise. 1000000 = ₹10,000 per transfer.
# PAYMENT_MAX_PAISE=1000000
# The first transfer to a number never paid before. With no payee list and
# arbitrary numbers, this is the main protection against a misheard digit.
# 50000 = ₹500.
# PAYMENT_FIRST_TIME_CAP_PAISE=50000

# Everything one payer can send in a calendar day. The per-transaction caps
# bound each mistake; only this bounds the total. 2500000 = ₹25,000.
# PAYMENT_DAILY_CAP_PAISE=2500000

# How a payee may be named:
#   contact_preferred — dictated numbers allowed, with a digit read-back (default)
#   contact_only      — a shared WhatsApp contact card or a known payee, nothing else
#   voice_allowed     — dictated numbers, no read-back required
# A shared contact card is the only path where the digits never touch speech
# recognition, so contact_only is the strongest setting available.
# PAYMENT_PAYEE_INPUT_MODE=contact_preferred

# How long a prepared transfer stays confirmable, in seconds. Short, so a PIN
# spoken much later cannot authorise something the user has forgotten about.
# PAYMENT_INTENT_TTL_S=180
# PAYMENT_MAX_PIN_ATTEMPTS=3
# PAYMENT_PIN_LENGTHS=4,6

# POC ONLY — the stub gateway's correct PIN. A real gateway verifies against
# eko's systems and ignores this. Never reuse a real banking PIN here.
# PAYMENT_STUB_PIN=1234

# Append-only audit trail (JSONL). Empty is fine for local work, but a gateway
# that moves real money REFUSES TO START without one — a payment system with no
# trail cannot answer the only question that matters afterwards.
# Contains full phone numbers, so it is personal data under DPDP: encrypted
# storage, stated retention. It never contains a PIN.
PAYMENT_AUDIT_PATH=

# ─── eko API — PASTE YOUR CREDENTIALS HERE ──────────────────────────────────
# Fill these in and set PAYMENT_GATEWAY=eko above. Nothing else changes: the PIN
# gate, the caps and the amount parser all sit above this boundary.
#
# ⚠️ PAYMENT_GATEWAY=eko is the moment fake money becomes real. Do not set it
#    until compliance has signed off on the authorisation mechanism — a SPOKEN
#    PIN is not a valid second factor under the RBI Authentication Mechanisms
#    for Digital Payment Transactions Directions, 2025 (see docs/voice-payments.md).

EKO_BASE_URL=
EKO_API_KEY=
# Some eko APIs want a second secret alongside the key. Leave blank if not.
EKO_SECRET_KEY=

# How the key is sent. Defaults suit "Authorization: Bearer <key>".
# EKO_AUTH_HEADER=Authorization
# EKO_AUTH_SCHEME=Bearer          # blank to send the raw key with no prefix
# EKO_SECRET_HEADER=X-Eko-Secret
# EKO_TIMEOUT_S=30

# Endpoint paths, relative to EKO_BASE_URL.
# EKO_RESOLVE_PATH=/payee/resolve
# EKO_TRANSFER_PATH=/transfer
# Optional. Without it the daily cap only counts transfers made through this
# bot — which is weaker than it looks, because it misses every other channel.
# EKO_SPENT_TODAY_PATH=

# Where to find each value INSIDE eko's JSON responses (dotted paths). These are
# guesses until the real contract is known — correct them rather than editing
# code. A missing field is not invented: the gateway raises instead.
# EKO_FIELD_PAYEE_NAME=data.name
# EKO_FIELD_PAYEE_ACCOUNT=data.account
# EKO_FIELD_PAYEE_KNOWN=data.is_existing_payee
# EKO_FIELD_SPENT_TODAY=data.spent_today_paise
# EKO_FIELD_REFERENCE=data.reference

# What eko calls each field in a TRANSFER REQUEST body.
# EKO_REQ_PAYER=payer
# EKO_REQ_PAYEE=payee
# EKO_REQ_AMOUNT=amount_paise
# EKO_REQ_PIN=pin
# EKO_REQ_IDEMPOTENCY=idempotency_key

# ─── Phase 6: deployment ────────────────────────────────────────────────────
# text for a terminal, json for a hosting platform's log aggregator.
# LOG_FORMAT=text
# LOG_LEVEL=INFO
# PORT=8000                      # most platforms inject this

# More than one worker REQUIRES shared state. Deduplication, pending transfers
# and rate limits are per-process, so without Redis several workers mean a voice
# note gets two replies, a spoken PIN finds no transfer waiting, and the rate
# limit is effectively multiplied by the worker count. Startup refuses that
# combination rather than letting it pass quietly.
# WEB_CONCURRENCY=1
# REDIS_URL=redis://localhost:6379/0

# ─── Demo UI (not part of the product) ──────────────────────────────────────
# Mounts /demo, which the React app in frontend/ calls. These endpoints BYPASS
# the WhatsApp allowlist — an HTTP caller has no verified phone number — so this
# is off by default. Never enable it where real data is reachable.
# See docs/demo-ui.md
DEMO_ENABLED=false
# Shared secret, sent as X-Demo-Token. Set it for anything reachable by others.
DEMO_TOKEN=
# DEMO_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

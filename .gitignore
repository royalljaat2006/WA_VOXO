# Secrets
.env

# Python
.venv/
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.ruff_cache/

# Voice notes, transcripts and results may contain real customer or business
# data — never commit them.
data/audio/*
!data/audio/.gitkeep
data/results/
data/.cache/
data/ground_truth.json

# Real employee phone numbers (WHATSAPP_ALLOWED_NUMBERS_FILE) — PII, never commit.
data/allowed_numbers.txt

# Google Cloud service-account keys — never commit. Drop the downloaded JSON
# key file here and point GOOGLE_APPLICATION_CREDENTIALS at it.
secrets/

# macOS
.DS_Store

# Windows: stray file created when a cmd-style `> nul` / `2> nul` redirect
# runs under a POSIX shell instead of cmd.exe, which doesn't treat NUL as
# the null device and creates a literal file named "nul".
nul

# Demo UI
frontend/node_modules/
frontend/dist/
frontend/.env
